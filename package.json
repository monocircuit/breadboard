{
  "name": "@monocircuit/breadboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The dev workflow of the repo: worktrees, stacks, the overview, the herdr plugin, the Chromium extension",
  "scripts": {
    "lint": "eslint . && pnpm lint:rs",
    "lint:rs": "cargo fmt --check && cargo clippy --all-targets --quiet -- -D warnings",
    "test": "node --test && pnpm test:rs",
    "test:rs": "cargo test --quiet",
    "build:rs": "cargo build --release --quiet"
  },
  "devDependencies": {
    "@monocircuit/eslint-config": "workspace:*",
    "eslint": "^9.25.1"
  }
}
